{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UE5 Systems Training Tool pack",
  "type": "object",
  "required": ["format", "schema", "kind", "name", "author", "version", "content"],
  "properties": {
    "format": { "const": "bbpack" },
    "schema": { "const": 1 },
    "kind": { "enum": ["project", "template", "lesson", "bundle"] },
    "name": { "type": "string", "minLength": 1 },
    "author": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "content": { "type": "object" }
  },
  "additionalProperties": true
}
